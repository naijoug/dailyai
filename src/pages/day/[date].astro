---
import BL from '../../components/BL.astro';
import { tagSlug } from '../../content.config';
import I from '../../components/I.astro';
import L from '../../components/L.astro';
import DayTitle from '../../components/DayTitle.astro';
import { t } from '../../lib/i18n';
import Base from '../../layouts/Base.astro';
import { render } from 'astro:content';
import { url } from '../../lib/posts';
import { allDays, hhmm, parseCov, covPlain } from '../../lib/days';
import { ivText } from '../../lib/interviews';
import { rangeText } from '../../lib/tz';
import { iattr } from '../../lib/i18n';
const MD = 'https://github.com/naijoug/dailyai/blob/main/daily/';
export async function getStaticPaths() {
  const days = await allDays();
  return days.map((d, i) => ({ params: { date: d.date }, props: { day: d, newer: days[i - 1], older: days[i + 1] } }));
}
const { day, newer, older } = Astro.props;
const render1 = async (p: any) => ({ p, Content: (await render(p)).Content });
const sections = [
  { key: 'x-ai', label: 'AI Hot', list: await Promise.all(day.xai.map(render1)) },
  { key: 'tech', label: 'Tech', list: await Promise.all(day.tech.map(render1)) },
].filter((s) => s.list.length);
---
<Base tkey="day.title" targs={{ date: day.date, wdk: day.wd }} description={day.summaryEn || day.summary}>
  <article class="prose day" data-pagefind-body data-day={day.date} data-total={day.total} data-pids={day.pids.join(',')}>
    <p class="muted crumb"><a href={url('/')}>Daily AI</a> / <I k="day.crumb" /></p>
    <h1><DayTitle date={day.date} wd={day.wd} /></h1>
    <div class="dsum"><BL en={day.summaryEn} zh={day.summary} /></div>
    <div class="dbar" data-pagefind-ignore>
      <button type="button" class="tzbtn tzv" data-tz-open data-tz-label data-tz-at={`${day.date}T12:00:00+08:00`} aria-haspopup="dialog" aria-expanded="false">UTC+8</button>
      {day.posts.length > 0 && <I class="muted tzrest" k="day.meta" a={{ n: day.posts.length, t: day.total }} />}
      {day.ivCount > 0 && <a class="muted" href="#interviews"><I k="iv.count" a={{ n: day.ivCount }} /></a>}
      <span class="dprog" data-dprog>{t('prog', { r: 0, t: day.total })}</span>
      <a class="mdlink" href={`${MD}${day.date.slice(0, 4)}/${day.date.slice(5, 7)}/${day.date}.md`} target="_blank" rel="noopener" {...iattr({ title: 'md.title' })}><I k="md.link" /> ↗</a>
      <label class="dhide"><input type="checkbox" data-hideread /> <I k="day.hide" /></label>
    </div>
    <I tag="p" class="allread muted" k="day.allread" data-allread data-pagefind-ignore hidden />
    <div class="dtags">{day.tags.map((tg) => <I tag="a" class="chip" href={url(`/tags/${tagSlug(tg)}/`)} k={`tag.${tg}`} />)}</div>
    {sections.map((s) => <section class="dsec">
      <h2 class="dhead"><span class={`gbadge ${s.key}`}>{s.label}</span></h2>
      {s.list.map(({ p, Content }) => <div class="entry" id={p.id}>
        {(() => { const c = parseCov(p.data.coverage, p.data.date); return (
        <div class="tmark" data-pagefind-ignore>
          <span class="tchip tzv" data-tz-hm={p.data.date.toISOString()} data-tz-day={day.date}>{hhmm(p.data.date)}</span><small class="tzdd tzv" data-tz-dd></small>
          {c ? <em><I class="cov-l" k="day.cov" /> <span class="cov-r tzv" data-tz-cov data-tz-cs={new Date(c.s).toISOString()} data-tz-ce={new Date(c.e).toISOString()} title={c.note || undefined}>{rangeText(c.s, c.e, 'o:480')}</span></em>
            : p.data.coverage ? <em>{covPlain(p.data.coverage)}</em> : null}
        </div>); })()}
        <div class="ebody"><Content /></div>
      </div>)}
    </section>)}
    {day.ivs.length > 0 && <section class="dsec ivsec" id="interviews">
      <h2 class="dhead"><span class="gbadge iv"><I k="iv.sec" /></span></h2>
      <ul class="ivlist">{day.ivs.map((iv) => { const ti = ivText(iv, 'title'); const su = ivText(iv, 'summary'); return (
        <li class="ivcard" id={`iv-${iv.id}`}>
          <div class="ivtop"><span class={`tlb tl-${iv.data.kind === 'podcast' ? 'podcast' : 'interview'}`}><I k={`iv.kind.${iv.data.kind}`} /></span> <strong>{iv.data.show}</strong>{iv.data.duration && <span class="muted"> · {iv.data.duration}</span>}{iv.data.score && <span class={`ascore s${iv.data.score}`}>{iv.data.score}</span>}</div>
          <a class="ivtitle" href={url(`/interview/${iv.id}/`)}><BL orig={iv.data.lang} en={ti.en} zh={ti.zh} /></a>
          <p class="ivsum muted"><L en={su.en} zh={su.zh} /></p>
        </li>); })}</ul>
    </section>}
  </article>
  <nav class="pager" data-i18n-attrs='{"aria-label":"day.pager"}' aria-label="Pagination">
    <span>{older && <a href={url(`/day/${older.date}/`)}>← <DayTitle date={older.date} wd={older.wd} /></a>}</span>
    <span>{newer && <a href={url(`/day/${newer.date}/`)}><DayTitle date={newer.date} wd={newer.wd} /> →</a>}</span>
  </nav>
</Base>
<style is:global>
  .ivlist { list-style:none; padding:0; margin:0; display:grid; gap:10px; }
  .ivcard { border:1px solid var(--line); border-radius:8px; padding:10px 12px; background:var(--card); }
  .ivtop { display:flex; flex-wrap:wrap; align-items:center; gap:6px; font-size:13px; }
  .ivtop .ascore { margin-left:auto; }
  .ivtitle { display:block; margin:6px 0 2px; font-weight:600; line-height:1.45; text-decoration:none; color:var(--fg); }
  .ivtitle:hover { text-decoration:underline; }
  .ivsum { margin:2px 0 0; font-size:13.5px; }
</style>
<script>
  import { origParts, applyBL } from '../../lib/bilang';
  import { load, save, isRead, isFav, ratingOf, markRead, markFav, markRating, onStore } from '../../lib/store';
  import { favBtn, readBtn, setFav, setRead, starsHtml, setStars, starKeys } from '../../lib/icons';
  import { tt, onLang } from '../../lib/i18n';
  const art = document.querySelector<HTMLElement>('article.day')!;
  const day = art.dataset.day!;
  const total = Number(art.dataset.total);
  const items = [...art.querySelectorAll<HTMLElement>('li.item')];
  const prog = art.querySelector('[data-dprog]')!;
  // 手动标为未读的条目：本次会话内不再自动标已读
  const manualUnread = new Set<string>();
  const dsecs = [...art.querySelectorAll<HTMLElement>('.dsec:not(.ivsec)')];
  const allRead = art.querySelector<HTMLElement>('[data-allread]')!;
  // 「隐藏已读」时：整节/整期/小节标题下已无可见条目则一并隐藏，全部读完显示提示
  const refreshEmpty = () => {
    const hiding = art.classList.contains('hideread');
    const vis = (li: Element) => !(hiding && li.classList.contains('read') && !li.classList.contains('keep'));
    let any = false;
    for (const sec of dsecs) {
      let secAny = false;
      for (const en of sec.querySelectorAll<HTMLElement>('.entry')) {
        const lis = [...en.querySelectorAll('li.item')]; const enAny = lis.some(vis);
        for (const h of en.querySelectorAll<HTMLElement>('.ebody > h2, .ebody > h3')) {
          let n = h.nextElementSibling; let hAny = false;
          while (n && !/^H[1-6]$/.test(n.tagName)) { if (n.matches('li.item') || [...n.querySelectorAll('li.item')].some(vis)) hAny = true; n = n.nextElementSibling; }
          h.classList.toggle('allhid', !hAny);
        }
        en.classList.toggle('allhid', !enAny); if (enAny) secAny = true;
      }
      sec.classList.toggle('allhid', !secAny); if (secAny) any = true;
    }
    allRead.hidden = !(hiding && !any && items.length > 0);
  };
  const upd = () => {
    const st = load();
    let r = 0;
    for (const li of items) {
      const id = li.dataset.id!;
      const read = isRead(st, id); if (read) r++;
      li.classList.toggle('read', read);
      setRead(li.querySelector('[data-act=read]')!, read);
      setFav(li.querySelector('[data-act=fav]')!, isFav(st, id));
      const rt = ratingOf(st, id);
      setStars(li, rt);
    }
    prog.textContent = tt('prog', { r, t: total });
    refreshEmpty();
  };
  for (const li of items) {
    const meta = li.querySelector('.imeta')!;
    [...meta.children].forEach((c) => { if (!c.matches('details.itr')) c.setAttribute('data-pagefind-ignore', ''); });
    meta.insertAdjacentHTML('beforeend',
      starsHtml() +
      favBtn() + readBtn());
    starKeys(meta);
    meta.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest('button'); if (!b) return;
      const st = load(); const id = li.dataset.id!;
      if (b.dataset.star) { const n = Number(b.dataset.star); markRating(st, id, ratingOf(st, id) === n ? null : n); }
      else if (b.dataset.act === 'read') { if (isRead(st, id)) { markRead(st, id, false); manualUnread.add(id); li.classList.remove('dim'); } else { markRead(st, id, true); if (art.classList.contains('hideread')) li.classList.add('keep'); } }
      else if (b.dataset.act === 'fav') {
        if (isFav(st, id)) markFav(st, id, null);
        else {
          // 始终按原文方向存储（主文可能已按 UI 语言换成译文）
          const o = origParts(li);
          markFav(st, id, { id, day, html: o.html, text: o.text, score: Number(li.dataset.score) || undefined, ...(o.tr ? { tr: o.tr } : {}) });
        }
      }
      save(st); upd();
    });
    li.querySelector('.itext')!.addEventListener('click', (e) => {
      if (!(e.target as HTMLElement).closest('a')) return;
      const st = load(); const id = li.dataset.id!;
      if (!isRead(st, id)) { markRead(st, id, true); save(st); upd(); }
    });
  }
  const hide = art.querySelector<HTMLInputElement>('[data-hideread]')!;
  hide.checked = localStorage.getItem('dailyai:hideread') === '1';
  const applyHide = () => { items.forEach((li) => li.classList.remove('keep')); art.classList.toggle('hideread', hide.checked); localStorage.setItem('dailyai:hideread', hide.checked ? '1' : '0'); };
  hide.addEventListener('change', () => { applyHide(); refreshEmpty(); }); applyHide();
  upd(); onLang(() => upd());
  // ===== 自动已读：按内容长度计算停留时间 =====
  // 有效字数 units = CJK 字符 ×cjkWeight + 拉丁单词 ×wordWeight（不含链接文字、@handle、[AI:N] 标记）
  // fullReadSeconds = units / wpm * 60；requiredSeconds = clamp(fullReadSeconds * fraction, minSec, maxSec)
  // 只在条目 ≥visibleRatio 可见（或占满视口 ≥visibleRatio）、标签页可见、窗口聚焦、且 idleMs 内有用户输入时累计。
  // 离开视口只暂停不清零；离开超过 outResetMs 清零。单个 setInterval tick 累计。
  const CFG = Object.assign({ cjkWeight: 1, wordWeight: 2, wpm: 450, fraction: 0.5, minSec: 3, maxSec: 25, visibleRatio: 0.6, outResetMs: 30000, idleMs: 60000, tickMs: 250 }, (window as any).__dailyaiReadCfg || {});
  const unitsOf = (li: HTMLElement) => {
    const c = li.querySelector('.itext')!.cloneNode(true) as HTMLElement;
    c.querySelectorAll('a').forEach((a) => a.remove());
    const t = (c.textContent || '').replace(/https?:\/\/\S+/g, ' ').replace(/\[AI:?\s*\d\]/gi, ' ').replace(/@\w+/g, ' ');
    const cjk = (t.match(/[\u3400-\u4dbf\u4e00-\u9fff\u3040-\u30ff\uac00-\ud7af]/g) || []).length;
    const words = (t.replace(/[\u3400-\u9fff\u3040-\u30ff\uac00-\ud7af]/g, ' ').match(/[A-Za-z0-9][A-Za-z0-9._'\-]*/g) || []).length;
    return cjk * CFG.cjkWeight + words * CFG.wordWeight;
  };
  type Tr = { li: HTMLElement; req: number; acc: number; out: number; btn: HTMLElement };
  const trs: Tr[] = items.map((li) => {
    const units = unitsOf(li);
    const req = Math.min(CFG.maxSec, Math.max(CFG.minSec, (units / CFG.wpm) * 60 * CFG.fraction));
    li.dataset.readSeconds = req.toFixed(1); li.dataset.readUnits = String(units);
    return { li, req, acc: 0, out: 0, btn: li.querySelector('[data-act=read]') as HTMLElement };
  });
  // 切换 UI 语言后主文换了语言 → 按当前可见主文重新计算停留时间
  onLang(() => { applyBL(); for (const t of trs) { const units = unitsOf(t.li); t.req = Math.min(CFG.maxSec, Math.max(CFG.minSec, (units / CFG.wpm) * 60 * CFG.fraction)); t.li.dataset.readSeconds = t.req.toFixed(1); t.li.dataset.readUnits = String(units); } });
  const autoRead = (li: HTMLElement) => {
    const id = li.dataset.id!; if (manualUnread.has(id)) return;
    const st = load(); if (isRead(st, id)) return;
    markRead(st, id, true); save(st);
    if (art.classList.contains('hideread')) li.classList.add('keep');
    upd();
  };
  const paintRing = (t: Tr, unread: boolean) => {
    const pct = unread ? Math.min(100, (t.acc / t.req) * 100) : 0;
    t.btn.style.setProperty('--rp', pct.toFixed(1));
    t.btn.classList.toggle('prog', pct > 0);
    t.li.dataset.readAcc = t.acc.toFixed(1);
  };
  let lastInput = Date.now();
  const touch = () => { lastInput = Date.now(); };
  for (const ev of ['scroll', 'wheel', 'mousemove', 'keydown', 'touchstart', 'touchmove', 'pointerdown']) window.addEventListener(ev, touch, { passive: true, capture: true });
  let last = performance.now();
  setInterval(() => {
    const now = performance.now(); const dt = Math.min(now - last, CFG.tickMs * 4); last = now;
    const active = document.visibilityState === 'visible' && document.hasFocus() && Date.now() - lastInput < CFG.idleMs;
    const vh = innerHeight; const st = load();
    // 严格串行：只有文档顺序中最靠上的可见未读条目累计停留并转圈，其余可见未读条目保持 0。
    const vis: { t: Tr; top: number }[] = [];
    for (const t of trs) {
      const id = t.li.dataset.id!; const unread = !isRead(st, id);
      if (!unread || manualUnread.has(id)) { t.acc = 0; paintRing(t, false); continue; }
      const r = t.li.getBoundingClientRect();
      const visH = Math.max(0, Math.min(r.bottom, vh) - Math.max(r.top, 0));
      const enough = r.height > 0 && (visH / r.height >= CFG.visibleRatio || visH >= vh * CFG.visibleRatio);
      if (enough) { t.out = 0; vis.push({ t, top: r.top + scrollY }); }
      else {
        if (!t.out) t.out = Date.now();
        else if (t.acc && Date.now() - t.out > CFG.outResetMs) t.acc = 0;
        paintRing(t, true);
      }
    }
    vis.sort((x, y) => x.top - y.top);
    vis.forEach(({ t }, i) => {
      if (i > 0) { t.acc = 0; paintRing(t, true); return; }
      if (active) { t.acc += dt / 1000; if (t.acc >= t.req) { t.acc = t.req; paintRing(t, true); autoRead(t.li); return; } }
      paintRing(t, true);
    });
  }, CFG.tickMs);
  // 变暗与已读解耦：刚标已读的条目保持明亮，离开视口后才加 dim；页面加载时已读条目直接 dim。
  { const st = load(); items.forEach((li) => li.classList.toggle('dim', isRead(st, li.dataset.id!))); }
  onStore(upd);
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((ents) => {
      for (const e of ents) if (!e.isIntersecting) (e.target as HTMLElement).classList.toggle('dim', (e.target as HTMLElement).classList.contains('read'));
    }, { threshold: [0] });
    items.forEach((li) => io.observe(li));
  }
</script>
