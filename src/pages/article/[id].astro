---
import BL from '../../components/BL.astro';
// 爆款长文详情页：原文逐段 + 默认折叠的译文（docs/articles.md）
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import I from '../../components/I.astro';
import L from '../../components/L.astro';
import { url } from '../../lib/posts';
import { t, iattr } from '../../lib/i18n';
import { GLOBE } from '../../lib/icons';
export async function getStaticPaths() {
  return (await getCollection('articles')).map((a) => ({ params: { id: a.id }, props: { a } }));
}
const { a } = Astro.props;
const { Content } = await render(a);
const d = a.data;
const trLang = d.lang === 'en' ? 'zh' : 'en';
const pub = d.published.toISOString().slice(0, 10);
const itemHref = d.item ? url(`/day/${d.day}/#${d.item}`) : url(`/day/${d.day}/`);
const who = d.handle ? `${d.author} (@${d.handle})` : d.author;
---
<Base title={d.title} description={`${d.title} — ${d.author}`}>
  <meta slot="head" name="robots" content="noindex" />
  <article class="artp" data-tlang={trLang}>
    <nav class="crumb muted"><a href={url(`/day/${d.day}/`)}><I k="art.day" a={{ d: d.day }} /></a> / <I k="art.crumb" /></nav>
    <h1><BL orig={d.lang === 'zh' ? 'zh' : 'en'} en={d.lang === 'zh' ? d.title_tr : d.title} zh={d.lang === 'zh' ? d.title : d.title_tr} /></h1>
    <div class="ameta muted">
      <I k="art.by" a={{ a: who }} />
      <span>· <I k="art.published" /> <time datetime={d.published.toISOString()}>{pub}</time></span>
      <span>· <a href={d.source_url} target="_blank" rel="noopener"><I k="art.source" /> ↗</a></span>
      <span>· <a href={`https://github.com/naijoug/dailyai/blob/main/daily/articles/${a.id}.md`} target="_blank" rel="noopener" {...iattr({ title: 'md.title' })}><I k="md.link" /> ↗</a></span>
      <button type="button" class="ibtn icob alay" data-tlay aria-pressed="false" {...iattr({ title: 'art.lay.sbs', 'aria-label': 'art.lay.sbs' })} set:html={'<svg class="ic" viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"><rect x="3.5" y="4.5" width="17" height="15" rx="1.5"/><path d="M12 4.5v15M6 9h3.5M6 12h3.5M14.5 9H18M14.5 12H18"/></svg>'} />
      <button type="button" class="ibtn icob atoggle" data-tall aria-pressed="false" {...iattr({ title: 'art.toggle', 'aria-label': 'art.toggle' })} set:html={GLOBE} />
    </div>
    <aside class="abanner">
      <strong><I k="art.banner.label" /></strong>
      <p><I k="art.banner" a={{ a: who }} /> <a href={d.source_url} target="_blank" rel="noopener">{d.source_url}</a></p>
    </aside>
    <div class="abody" lang={d.lang === 'zh' ? 'zh-CN' : 'en'}><Content /></div>
    <p class="aback muted"><a href={itemHref}>← <I k="art.day" a={{ d: d.day }} /></a></p>
  </article>
</Base>
<style is:global>
  .artp h1 { margin:.3em 0 .1em; line-height:1.3; }
  .artp .atitle-tr { margin:0 0 .6em; }
  .artp .crumb { font-size:13px; }
  .ameta { display:flex; flex-wrap:wrap; align-items:center; gap:4px 8px; font-size:13px; }
  .ameta .alay { margin-left:auto; }
  .alay.on { color:#c96a4b; } [data-theme=dark] .alay.on { color:#e0a38a; }
  @media (max-width:767px) { .ameta .alay { display:none; } }
  /* 左右对照：每段一行 grid，主文在左、另一语言在右，行高对齐；始终展开，隐藏地球 */
  @media (min-width:768px) {
    .artp.sbs .ameta .atoggle { display:none; }
    .artp.sbs .abody .apara { display:grid; grid-template-columns:1fr 1fr; gap:0 28px; margin:0 0 1.1em; }
    .artp.sbs .abody .apara > .atext { grid-column:1; }
    .artp.sbs .abody .apara > details.atr { grid-column:2; display:block; margin:0; }
    .artp.sbs .abody .apara > details.atr > .itr-body { margin:0; }
    .artp.sbs .abody .apara > .atext > :first-child, .artp.sbs .abody .apara > .atext > .lic + * { margin-top:0; }
    .artp.sbs .abody { max-width:none; }
  }
  .atoggle.on { color:#c96a4b; } [data-theme=dark] .atoggle.on { color:#e0a38a; }
  .abanner { margin:14px 0 22px; padding:10px 14px; border:1px solid color-mix(in srgb, var(--accent) 45%, transparent); border-left:4px solid var(--accent); border-radius:8px; background:color-mix(in srgb, var(--accent) 7%, transparent); font-size:13.5px; }
  .abanner p { margin:.3em 0 0; } .abanner a { word-break:break-all; text-decoration:underline; }
  .abody { line-height:1.8; }
  .abody img { max-width:100%; height:auto; }
  .abody pre { overflow-x:auto; }
  .abody .apara > .atext > .lic { height:1.8em; }
  .artp h1 .blx .itr-body { font-size:.55em; font-weight:400; line-height:1.5; }
  /* 文章页只保留顶部一个地球开关：隐藏逐段与标题旁的地球按钮 */
  .artp details.itr > summary { display:none !important; }
  .abody details.atr { display:flex; flex-wrap:wrap; align-items:flex-start; margin:-.6em 0 1em; }
  .abody details.atr > summary { order:0; width:26px; height:24px; }
  .abody details.atr::details-content { flex:0 0 100%; }
  .abody details.atr > .itr-body { margin-top:2px; }
  .aback { margin-top:2em; font-size:13px; }
</style>
<script>
  import { tt, onLang } from '../../lib/i18n';
  import { syncTr } from '../../lib/icons';
  const btn = document.querySelector<HTMLElement>('[data-tall]')!;
  const all = () => [...document.querySelectorAll<HTMLDetailsElement>('.artp details.itr')];
  const paint = () => {
    const on = all().length > 0 && all().every((d) => d.open);
    btn.classList.toggle('on', on); btn.setAttribute('aria-pressed', String(on));
    const l = tt(on ? 'art.toggle.hide' : 'art.toggle'); btn.title = l; btn.setAttribute('aria-label', l);
  };
  // 版式：inline（逐段）/ sbs（左右对照），记在 localStorage；窄屏 CSS 回退为 inline
  const art = document.querySelector<HTMLElement>('.artp')!; const lay = document.querySelector<HTMLElement>('[data-tlay]')!; const LK = 'dailyai:artlayout';
  let saved: boolean[] | null = null;
  const sbsOn = () => art.classList.contains('sbs') && matchMedia('(min-width:768px)').matches;
  const paintLay = () => { const on = art.classList.contains('sbs'); lay.classList.toggle('on', on); lay.setAttribute('aria-pressed', String(on)); const l = tt(on ? 'art.lay.inline' : 'art.lay.sbs'); lay.title = l; lay.setAttribute('aria-label', l); };
  const applyLay = () => {
    if (sbsOn()) { if (!saved) saved = all().map((d) => d.open); all().forEach((d) => { d.open = true; }); }
    else if (saved) { const s = saved; saved = null; all().forEach((d, i) => { d.open = s[i] ?? false; }); }
    syncTr(); paint(); paintLay();
  };
  const setLay = (sbs: boolean) => { art.classList.toggle('sbs', sbs); try { localStorage.setItem(LK, sbs ? 'sbs' : 'inline'); } catch {} applyLay(); };
  lay.addEventListener('click', () => setLay(!art.classList.contains('sbs')));
  try { art.classList.toggle('sbs', localStorage.getItem(LK) === 'sbs'); } catch {}
  matchMedia('(min-width:768px)').addEventListener('change', applyLay);
  onLang(paintLay); applyLay();
  btn.addEventListener('click', () => { const open = !all().every((d) => d.open); all().forEach((d) => { d.open = open; }); syncTr(); paint(); });
  document.addEventListener('toggle', () => paint(), true);
  onLang(paint); paint();
</script>
