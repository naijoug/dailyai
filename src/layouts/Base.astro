---
import { url } from '../lib/posts';
import { t } from '../lib/i18n';
import I from '../components/I.astro';
interface Props { title?: string; tkey?: string; targs?: Record<string, any>; description?: string; wide?: boolean }
const { title, tkey, targs, wide = false, description = 'Daily AI and tech news digest' } = Astro.props;
const label = tkey ? t(tkey, targs) : title;
const full = label ? `${label} | Daily AI` : t('site.title');
const path = Astro.url.pathname;
const nav = (p: string) => (p === '/' ? path === url('/') || path === url('') : path.startsWith(url(p.replace(/\/$/, '')))) ? 'on' : '';
---
<!doctype html>
<html lang="en" data-lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  {tkey ? <title data-tkey={tkey} data-i18n-a={targs ? JSON.stringify(targs) : undefined}>{full}</title> : title ? <title data-tfixed>{full}</title> : <title>{full}</title>}
  <meta name="description" content={description} />
  <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
  <link rel="preload" href={url('/fonts/fira-code-latin.woff2')} as="font" type="font/woff2" crossorigin />
  <style is:inline set:html={`@font-face{font-family:'Fira Code';font-style:normal;font-weight:300 700;font-display:swap;src:url(${url('/fonts/fira-code-latin.woff2')}) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}@font-face{font-family:'Fira Code';font-style:normal;font-weight:300 700;font-display:swap;src:url(${url('/fonts/fira-code-latin-ext.woff2')}) format('woff2');unicode-range:U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF}`} />
  <slot name="head" />
  <link rel="alternate" type="application/rss+xml" title="Daily AI" href={url('/rss.xml')} />
  <script is:inline>
    (function(){try{var l=localStorage.getItem('dailyai:lang');if(l!=='zh')l='en';var h=document.documentElement;h.setAttribute('data-lang',l);if(l==='zh'){h.lang='zh-CN';h.classList.add('i18n-wait');setTimeout(function(){h.classList.remove('i18n-wait')},2500);}}catch(e){}})();
  </script>
  <script is:inline>
    (function(){try{var p=localStorage.getItem('dailyai:tz')||'auto',h=document.documentElement,o;if(p.indexOf('o:')===0)o=+p.slice(2);else{var z=p.indexOf('z:')===0?p.slice(2):Intl.DateTimeFormat().resolvedOptions().timeZone;var n=Date.now(),m={};new Intl.DateTimeFormat('en-US',{timeZone:z,hourCycle:'h23',year:'numeric',month:'2-digit',day:'2-digit',hour:'2-digit',minute:'2-digit',second:'2-digit'}).formatToParts(new Date(n)).forEach(function(x){m[x.type]=x.value});o=Math.round((Date.UTC(+m.year,+m.month-1,+m.day,+m.hour%24,+m.minute,+m.second)-Math.floor(n/1000)*1000)/60000)}if(o!==480){h.classList.add('tz-wait');setTimeout(function(){h.classList.remove('tz-wait')},2500)}}catch(e){}})();
  </script>
  <noscript><style>.i18n-wait body{visibility:visible!important}.tz-wait .tzv{visibility:visible!important}</style></noscript>
  <script is:inline>
    (function(){var t=localStorage.getItem('theme');if(!t)t=matchMedia('(prefers-color-scheme: light)').matches?'light':'dark';document.documentElement.dataset.theme=t;})();
  </script>
</head>
<body>
  <header class="site">
    <div class:list={["wrap bar", { wide }]}>
      <a class="brand" href={url('/')}>Daily AI</a>
      <div class="hright">
        <nav class="mainnav" data-i18n-attrs='{"aria-label":"nav.label"}' aria-label={t('nav.label')}>
          <I tag="a" k="nav.home" href={url('/')} class={nav('/')} />
          <I tag="a" k="nav.products" href={url('/products/')} class={nav('/products/')} />
          <I tag="a" k="nav.reset" href={url('/codex-reset/')} class={nav('/codex-reset/')} />
          <I tag="a" k="nav.tags" href={url('/tags/')} class={nav('/tags/')} />
          <I tag="a" k="nav.search" href={url('/search/')} class={nav('/search/')} />
          <I tag="a" k="nav.favorites" href={url('/favorites/')} class={nav('/favorites/')} />
          <a href={url('/rss.xml')}>RSS</a>
        </nav>
        <div class="hctl">
          <div class="setwrap">
            <button type="button" id="settings" class="setbtn" aria-haspopup="dialog" aria-expanded="false" aria-controls="setpop" aria-label={t('set.open')} title={t('set.open')} data-i18n-attrs='{"aria-label":"set.open","title":"set.open"}'>
              <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M19.14 12.94c.04-.31.06-.63.06-.94s-.02-.63-.06-.94l2.03-1.58a.5.5 0 0 0 .12-.64l-1.92-3.32a.5.5 0 0 0-.6-.22l-2.39.96a7.2 7.2 0 0 0-1.63-.94l-.36-2.54a.5.5 0 0 0-.5-.42h-3.84a.5.5 0 0 0-.5.42l-.36 2.54c-.58.23-1.12.54-1.63.94l-2.39-.96a.5.5 0 0 0-.6.22L2.71 8.84a.5.5 0 0 0 .12.64l2.03 1.58c-.04.31-.06.63-.06.94s.02.63.06.94l-2.03 1.58a.5.5 0 0 0-.12.64l1.92 3.32c.13.23.4.32.6.22l2.39-.96c.5.4 1.05.71 1.63.94l.36 2.54c.05.24.26.42.5.42h3.84c.24 0 .45-.18.5-.42l.36-2.54c.58-.23 1.12-.54 1.63-.94l2.39.96c.23.1.47 0 .6-.22l1.92-3.32a.5.5 0 0 0-.12-.64l-2.03-1.58zM12 15.5A3.5 3.5 0 1 1 12 8.5a3.5 3.5 0 0 1 0 7z"/></svg>
            </button>
            <div id="setpop" class="setpop" role="dialog" aria-modal="false" aria-labelledby="setpop-title" tabindex="-1" hidden>
              <div class="setp-h">
                <strong id="setpop-title" data-i18n="set.title">{t('set.title')}</strong>
                <button type="button" class="setp-x" data-set-close aria-label={t('set.close')} title={t('set.close')} data-i18n-attrs='{"aria-label":"set.close","title":"set.close"}'>×</button>
              </div>
              <div class="setf setf-row">
                <span class="setk" id="set-lang-l" data-i18n="lang.label">{t('lang.label')}</span>
                <span class="langsw" role="group" aria-labelledby="set-lang-l">
                  <button type="button" data-setlang="en" aria-pressed="true" lang="en" title="English">EN</button><button type="button" data-setlang="zh" aria-pressed="false" lang="zh-CN" title="中文">中</button>
                </span>
              </div>
              <div class="setf">
                <label class="setk" for="set-tz" data-i18n="tz.label">{t('tz.label')}</label>
                <select id="set-tz"></select>
              </div>
              <p class="muted setnote" data-i18n="tz.note">{t('tz.note')}</p>
              <div class="setf setf-row">
                <span class="setk" id="set-theme-l" data-i18n="theme.label">{t('theme.label')}</span>
                <span class="langsw" role="group" aria-labelledby="set-theme-l">
                  <button type="button" data-settheme="light" aria-pressed="false" data-i18n="theme.light">{t('theme.light')}</button><button type="button" data-settheme="dark" aria-pressed="false" data-i18n="theme.dark">{t('theme.dark')}</button>
                </span>
              </div>
              <div class="setf gh-row" id="gh-row" hidden>
                <div class="setf-row">
                  <span class="setk" id="gh-acc-l" data-i18n="gh.account">{t('gh.account')}</span>
                  <button type="button" class="gh-btn" id="gh-signin" data-i18n="gh.signin">{t('gh.signin')}</button>
                  <span class="gh-user" id="gh-user" hidden>
                    <img id="gh-avatar" alt="" width="20" height="20" hidden />
                    <span id="gh-login"></span>
                    <button type="button" class="gh-btn" id="gh-signout" data-i18n="gh.signout">{t('gh.signout')}</button>
                  </span>
                </div>
                <p class="muted setnote" data-i18n="gh.sync">{t('gh.sync')}</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </header>
  <main class:list={["wrap", { wide }]}><slot /></main>
  <footer class="wrap foot"><I k="foot.text" /> · <I tag="a" k="foot.rss" href={url('/rss.xml')} /></footer>

  <script>
    import { applyI18n, setLang, updateSwitcher, getLang, tt, onLang } from '../lib/i18n';
    import { syncTr } from '../lib/icons';
    import { applyBL } from '../lib/bilang';
    import { applyTz, getPref, setPref, effectiveZone, offsetAt, offsetLabel, COMMON_ZONES, OFFSETS, onTz } from '../lib/tz';
    import { bootGithub, configured as ghConfigured, getSession } from '../lib/github-sync';
    if (getLang() !== 'en') applyI18n();
    applyBL(); syncTr();
    updateSwitcher();
    applyTz();
    // 译文开关（地球图标）：名称随开合状态与语言同步
    document.addEventListener('toggle', (e) => { const d = e.target as HTMLElement; if (d.matches?.('details.itr')) syncTr(d.parentElement!); }, true);
    onLang(() => { applyBL(); syncTr(); });
    // ---- 时区弹层 ----
    let pop: HTMLElement | null = null; let anchor: HTMLElement | null = null;
    const zlabel = (p: string) => offsetLabel(offsetAt(Date.now(), p));
    const paintBtns = () => {
      const l = zlabel(getPref());
      document.querySelectorAll<HTMLElement>('[data-tz-open]').forEach((b) => { const txt = tt('tz.btn', { z: b.textContent || l }); b.title = txt; b.setAttribute('aria-label', txt); });
    };
    const fillSelect = (sel: HTMLSelectElement) => {
      const cur = getPref(); sel.innerHTML = '';
      const opt = (v: string, text: string, parent: Element) => { const o = document.createElement('option'); o.value = v; o.textContent = text; if (v === cur) o.selected = true; parent.appendChild(o); };
      const browser = effectiveZone('auto').z || 'UTC';
      opt('auto', tt('tz.auto.cur', { z: `${browser} ${zlabel('auto')}` }), sel);
      const g1 = document.createElement('optgroup'); g1.label = tt('tz.common'); sel.appendChild(g1);
      for (const z of COMMON_ZONES) opt('z:' + z, `${tt('tz.' + z)} (${zlabel('z:' + z)})`, g1);
      if (cur.startsWith('z:') && !COMMON_ZONES.includes(cur.slice(2))) opt(cur, `${cur.slice(2)} (${zlabel(cur)})`, g1);
      const g2 = document.createElement('optgroup'); g2.label = tt('tz.offsets'); sel.appendChild(g2);
      for (const m of OFFSETS) opt('o:' + m, offsetLabel(m), g2);
    };
    const fill = () => {
      fillSelect(pop!.querySelector('select')!);
      pop!.querySelector('[data-tzp-title]')!.textContent = tt('tz.label');
      pop!.querySelector('[data-tzp-note]')!.textContent = tt('tz.note');
      pop!.setAttribute('aria-label', tt('tz.label'));
      const c = pop!.querySelector<HTMLElement>('[data-tzp-close]')!; c.setAttribute('aria-label', tt('tz.close')); c.title = tt('tz.close');
    };
    const place = () => {
      if (!pop || !anchor) return; const r = anchor.getBoundingClientRect(); const w = pop.offsetWidth;
      pop.style.top = `${Math.round(r.bottom + 6)}px`; pop.style.left = `${Math.round(Math.max(8, Math.min(r.left, innerWidth - w - 8)))}px`;
    };
    const closePop = (refocus = true) => { if (!pop || pop.hidden) return; pop.hidden = true; document.querySelectorAll('[data-tz-open]').forEach((b) => b.setAttribute('aria-expanded', 'false')); if (refocus) anchor?.focus(); };
    const openPop = (a: HTMLElement) => {
      if (!pop) {
        pop = document.createElement('div'); pop.id = 'tzpop'; pop.setAttribute('role', 'dialog'); pop.hidden = true;
        pop.innerHTML = '<div class="tzp-h"><strong data-tzp-title></strong><button type="button" data-tzp-close>×</button></div><select aria-labelledby="tzp-t"></select><p class="muted" data-tzp-note></p>';
        pop.querySelector('[data-tzp-title]')!.id = 'tzp-t';
        document.body.appendChild(pop);
        pop.querySelector('select')!.addEventListener('change', (e) => { setPref((e.target as HTMLSelectElement).value); closePop(); });
        pop.querySelector('[data-tzp-close]')!.addEventListener('click', () => closePop());
        pop.addEventListener('keydown', (e) => { if (e.key === 'Escape') { e.stopPropagation(); closePop(); } });
      }
      anchor = a; fill(); pop.hidden = false; place();
      document.querySelectorAll('[data-tz-open]').forEach((b) => b.setAttribute('aria-expanded', String(b === a)));
      pop.querySelector('select')!.focus();
    };
    document.addEventListener('click', (e) => {
      const t = e.target as HTMLElement; const b = t.closest<HTMLElement>('[data-tz-open]');
      if (b) { if (pop && !pop.hidden && anchor === b) closePop(); else openPop(b); return; }
      if (pop && !pop.hidden && !pop.contains(t)) closePop(false);
    });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closePop(); });
    addEventListener('resize', place);
    const setSel = document.getElementById('set-tz') as HTMLSelectElement;
    const fillSetTz = () => fillSelect(setSel);
    fillSetTz();
    setSel.addEventListener('change', () => setPref(setSel.value));
    onTz(() => { paintBtns(); if (pop && !pop.hidden) fill(); fillSetTz(); }); onLang(() => { paintBtns(); if (pop && !pop.hidden) fill(); fillSetTz(); });
    paintBtns();
    document.documentElement.classList.remove('i18n-wait');
    document.querySelectorAll<HTMLElement>('[data-setlang]').forEach((b) => b.addEventListener('click', () => { if (b.dataset.setlang !== getLang()) setLang(b.dataset.setlang as 'en' | 'zh'); }));
    const paintTheme = () => {
      const cur = document.documentElement.dataset.theme === 'light' ? 'light' : 'dark';
      document.querySelectorAll<HTMLElement>('[data-settheme]').forEach((b) => { const on = b.dataset.settheme === cur; b.classList.toggle('on', on); b.setAttribute('aria-pressed', String(on)); });
    };
    paintTheme();
    document.querySelectorAll<HTMLElement>('[data-settheme]').forEach((b) => b.addEventListener('click', () => {
      const next = b.dataset.settheme === 'light' ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      try { localStorage.setItem('theme', next); } catch {}
      paintTheme();
    }));
    const ghRow = document.getElementById('gh-row') as HTMLElement;
    const ghSign = document.getElementById('gh-signin') as HTMLButtonElement;
    const ghUser = document.getElementById('gh-user') as HTMLElement;
    const ghAvatar = document.getElementById('gh-avatar') as HTMLImageElement;
    const ghLogin = document.getElementById('gh-login') as HTMLElement;
    const paintGh = () => {
      if (!ghConfigured) { ghRow.hidden = true; return; }
      ghRow.hidden = false;
      const s = getSession();
      const on = !!s;
      ghSign.hidden = on;
      ghUser.hidden = !on;
      ghLogin.textContent = s?.login || '…';
      if (on && s?.avatar) { ghAvatar.src = s.avatar; ghAvatar.hidden = false; }
      else { ghAvatar.removeAttribute('src'); ghAvatar.hidden = true; }
    };
    paintGh();
    bootGithub({ onChange: paintGh, signIn: ghSign, signOut: document.getElementById('gh-signout') });
    const gear = document.getElementById('settings') as HTMLButtonElement;
    const setpop = document.getElementById('setpop') as HTMLElement;
    const openSet = () => { fillSetTz(); paintTheme(); paintGh(); setpop.hidden = false; gear.setAttribute('aria-expanded', 'true'); setpop.focus(); };
    const closeSet = (refocus = true) => { if (setpop.hidden) return; setpop.hidden = true; gear.setAttribute('aria-expanded', 'false'); if (refocus) gear.focus(); };
    document.addEventListener('click', (e) => {
      const t = e.target as Node;
      if (gear.contains(t)) { if (setpop.hidden) openSet(); else closeSet(false); return; }
      if (!setpop.hidden && !setpop.contains(t)) closeSet(false);
    });
    document.addEventListener('keydown', (e) => { if (e.key !== 'Escape' || setpop.hidden) return; e.stopPropagation(); closeSet(); }, true);
    setpop.querySelector('[data-set-close]')!.addEventListener('click', () => closeSet());
  </script>
</body>
</html>
<style is:global>
  html.i18n-wait body { visibility:hidden; }
  html[data-lang=en] [data-l=zh], html[data-lang=zh] [data-l=en] { display:none !important; }
  .langsw { display:inline-flex; border:1px solid var(--line); border-radius:7px; overflow:hidden; margin-left:6px; vertical-align:middle; }
  .langsw button { background:none; border:none; color:var(--muted); font:inherit; font-size:12px; line-height:1; padding:5px 8px; cursor:pointer; transition:background .15s, color .15s; }
  .langsw button + button { border-left:1px solid var(--line); }
  .langsw button:hover { background:var(--hover); color:var(--fg); }
  .langsw button.on { background:var(--chip); color:var(--fg); font-weight:700; }
  .langsw button:focus-visible { outline:2px solid var(--accent); outline-offset:-2px; }
  :root { --bg:#ffffff; --fg:#37352f; --muted:#787774; --line:rgba(55,53,47,.12); --card:#ffffff; --prev:#f7f6f3; --hover:#f1f1ef; --accent:#2383e2; --chip:#f1f1ef; --chipfg:#37352f; --b1:#e7f3f8; --b1f:#1f6c9f; --b2:#fbecdd; --b2f:#a65d1e; color-scheme: light; }
  [data-theme=dark] { --bg:#191919; --fg:#e6e6e6; --muted:#9b9b9b; --line:rgba(255,255,255,.08); --card:#2f2f2f; --prev:#373737; --hover:#3a3a3a; --accent:#529cca; --chip:#373737; --chipfg:#d4d4d4; --b1:#1f3a4d; --b1f:#8ec7ec; --b2:#4a3220; --b2f:#f0b47c; color-scheme: dark; }
  * { box-sizing: border-box; }
  html { background: var(--bg); color: var(--fg); }
  :root { --font: 'Fira Code', "PingFang SC", "Hiragino Sans GB", "Noto Sans SC", "Noto Sans CJK SC", "Microsoft YaHei", ui-monospace, sans-serif; }
  body { margin:0; font: 15px/1.85 var(--font); font-variant-ligatures: none; letter-spacing: -0.01em; -webkit-font-smoothing: antialiased; }
  button, input, select, textarea, code, kbd, pre, samp, h1, h2, h3, h4 { font-family: var(--font); }
  code, kbd, pre, samp { font-variant-ligatures: normal; font-feature-settings: "calt" 1, "liga" 1; letter-spacing: 0; }
  #search, .pagefind-ui { --pagefind-ui-font: var(--font); }
  a { color: var(--accent); text-decoration: none; } a:hover { text-decoration: underline; }
  .wrap { max-width: 1120px; margin: 0 auto; padding: 0 32px; }
  @media (max-width: 900px) { .wrap, .wrap.wide { padding-left:24px; padding-right:24px; } }
  header.site { border-bottom: 1px solid var(--line); position: sticky; top:0; background: var(--bg); z-index: 5; }
  .bar { display:flex; align-items:center; justify-content:space-between; min-height:56px; gap:12px; }
  .hright { display:flex; align-items:center; gap:14px; min-width:0; }
  .hctl { display:flex; align-items:center; gap:6px; flex:none; }
  .setwrap { position:relative; }
  .setbtn { display:inline-flex; align-items:center; justify-content:center; width:32px; height:32px; background:none; border:1px solid var(--line); color:var(--muted); border-radius:7px; cursor:pointer; padding:0; }
  .setbtn:hover { background:var(--hover); color:var(--fg); }
  .setbtn[aria-expanded=true] { background:rgba(201,106,75,.12); color:#c96a4b; border-color:rgba(201,106,75,.45); }
  [data-theme=dark] .setbtn[aria-expanded=true] { background:rgba(224,163,138,.14); color:#e0a38a; border-color:rgba(224,163,138,.4); }
  .setbtn:focus-visible { outline:2px solid #c96a4b; outline-offset:2px; }
  .setpop { position:absolute; right:0; top:calc(100% + 6px); z-index:30; width:min(320px, calc(100vw - 24px)); background:var(--card); color:var(--fg); border:1px solid var(--line); border-radius:10px; padding:10px 12px 12px; box-shadow:0 8px 28px rgba(0,0,0,.16); font-size:13.5px; line-height:1.5; }
  [data-theme=dark] .setpop { box-shadow:0 8px 28px rgba(0,0,0,.45); }
  .setpop[hidden] { display:none; }
  .setpop:focus { outline:none; }
  .setp-h { display:flex; justify-content:space-between; align-items:center; gap:8px; }
  .setp-h strong { font-size:13px; font-weight:650; }
  .setp-x { background:none; border:none; color:var(--muted); font:inherit; font-size:18px; line-height:1; cursor:pointer; padding:0 4px; border-radius:4px; }
  .setp-x:hover { color:var(--fg); }
  .setf { margin-top:10px; }
  .setf-row { display:flex; align-items:center; justify-content:space-between; gap:12px; }
  .setk { color:var(--muted); font-size:12.5px; }
  .setpop select { width:100%; margin-top:4px; background:var(--bg); color:var(--fg); border:1px solid var(--line); border-radius:6px; padding:6px 8px; font:inherit; font-size:12.5px; }
  .setnote { margin:6px 0 0; font-size:11.5px; line-height:1.5; }
  .setpop .langsw { margin-left:0; flex:none; }
  .setpop .langsw button.on { background:rgba(201,106,75,.14); color:#c96a4b; }
  [data-theme=dark] .setpop .langsw button.on { background:rgba(224,163,138,.16); color:#e0a38a; }
  .setpop select:focus-visible, .setpop button:focus-visible, .setp-x:focus-visible { outline:2px solid #c96a4b; outline-offset:1px; }
  .setpop [hidden] { display:none !important; }
  .gh-row .setf-row { flex-wrap:wrap; }
  .gh-btn { background:none; border:1px solid var(--line); color:var(--fg); border-radius:7px; cursor:pointer; font:inherit; font-size:12px; line-height:1.3; padding:6px 10px; }
  .gh-btn:hover { color:#c96a4b; border-color:rgba(201,106,75,.45); }
  [data-theme=dark] .gh-btn:hover { color:#e0a38a; border-color:rgba(224,163,138,.45); }
  .gh-user { display:inline-flex; align-items:center; gap:8px; min-width:0; }
  .gh-user img { width:20px; height:20px; border-radius:50%; }
  #gh-login { font-size:12.5px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; max-width:9em; }
  .brand { font-weight:700; font-size:18px; color: var(--fg); }
